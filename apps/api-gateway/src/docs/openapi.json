{
  "openapi": "3.0.3",
  "info": {
    "title": "Web Crawl Monitoring API",
    "version": "1.0.0",
    "description": "API Gateway for Web Crawl Accessibility & Compliance Monitoring System"
  },
  "servers": [
    {
      "url": "http://localhost/api"
    }
  ],
  "paths": {
    "/health": {
      "get": {
        "summary": "Health check",
        "responses": {
          "200": {
            "description": "Service is healthy"
          }
        }
      }
    },
    "/auth/signup": {
      "post": {
        "summary": "Register a new user",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SignUpRequest"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "User created"
          },
          "400": {
            "description": "Validation error"
          }
        }
      }
    },
    "/auth/login": {
      "post": {
        "summary": "Login user",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SignInRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Login successful"
          },
          "401": {
            "description": "Invalid credentials"
          }
        }
      }
    },
    "/auth/refresh": {
      "post": {
        "summary": "Refresh access token",
        "responses": {
          "200": {
            "description": "New access token issued"
          },
          "401": {
            "description": "Unauthorized"
          }
        }
      }
    },
    "/auth/logout": {
      "post": {
        "summary": "Logout user",
        "responses": {
          "200": {
            "description": "Logged out successfully"
          },
          "401": {
            "description": "Unauthorized"
          }
        }
      }
    },
    "/auth/me": {
      "get": {
        "summary": "Get current user",
        "responses": {
          "200": {
            "description": "User profile returned"
          },
          "401": {
            "description": "Unauthorized"
          }
        }
      }
    },
    "/auth/forgot-password": {
      "post": {
        "summary": "Forgot password",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ForgotPasswordRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Login successful"
          },
          "400": {
            "description": "Bad Request"
          }
        }
      }
    },
    "/auth/reset-password": {
      "post": {
        "summary": "Reset password",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ResetPasswordRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Login successful"
          },
          "400": {
            "description": "Bad Request"
          }
        }
      }
    },
    "/sites": {
      "get": {
        "summary": "Get all sites",
        "parameters": [
          {
            "name": "page",
            "in": "query",
            "schema": { "type": "integer", "default": 1 }
          },
          {
            "name": "limit",
            "in": "query",
            "schema": { "type": "string" }
          },
          {
            "name": "search",
            "in": "query",
            "schema": { "type": "string" }
          },
          {
            "name": "status",
            "in": "query",
            "schema": { "type": "string" }
          }
        ],
        "responses": {
          "200": { "description": "List of sites" },
          "401": { "description": "Unauthorized" }
        }
      },
      "post": {
        "summary": "Create a site",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateSiteRequest"
              }
            }
          }
        },
        "responses": {
          "201": { "description": "Site created" },
          "400": { "description": "Validation error" }
        }
      }
    },
    "/sites/{id}": {
      "get": {
        "summary": "Get site by ID",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": { "type": "string" }
          }
        ],
        "responses": {
          "200": { "description": "Site details" },
          "404": { "description": "Site not found" }
        }
      },
      "delete": {
        "summary": "Delete site",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": { "type": "string" }
          }
        ],
        "responses": {
          "200": { "description": "Site deleted" },
          "400": { "description": "Cannot delete site" }
        }
      }
    },
    "/crawl": {
      "get": {
        "summary": "Get all crawl jobs",
        "parameters": [
          {
            "name": "page",
            "in": "query",
            "schema": { "type": "integer", "default": 1 }
          },
          {
            "name": "limit",
            "in": "query",
            "schema": { "type": "integer" }
          }
        ],
        "responses": {
          "200": { "description": "List of crawl jobs" }
        }
      },
      "post": {
        "summary": "Start a crawl job",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateCrawlRequest"
              }
            }
          }
        },
        "responses": {
          "201": { "description": "Crawl started" },
          "400": { "description": "Invalid request" }
        }
      }
    },
    "/crawl/{id}": {
      "get": {
        "summary": "Get crawl job by ID",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": { "type": "string" }
          }
        ],
        "responses": {
          "200": { "description": "Crawl job details" },
          "404": { "description": "Not found" }
        }
      }
    },
    "/issues": {
      "get": {
        "summary": "Get accessibility issues",
        "parameters": [
          {
            "name": "page",
            "in": "query",
            "schema": { "type": "integer", "default": 1 }
          },
          {
            "name": "limit",
            "in": "query",
            "schema": { "type": "integer" }
          },
          {
            "name": "search",
            "in": "query",
            "schema": { "type": "string" }
          },
          {
            "name": "status",
            "in": "query",
            "schema": { "type": "string" }
          }
        ],
        "responses": {
          "200": { "description": "List of issues" }
        }
      }
    },
    "/issues/{id}": {
      "get": {
        "summary": "Get issue details",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": { "type": "string" }
          }
        ],
        "responses": {
          "200": { "description": "Issue details" },
          "404": { "description": "Issue not found" }
        }
      }
    },
    "/dashboard/summary": {
      "get": {
        "tags": ["Dashboard"],
        "summary": "Get dashboard summary metrics",
        "parameters": [
          {
            "name": "siteId",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "format": "uuid"
            },
            "description": "Site ID to get summary for"
          }
        ],
        "responses": {
          "200": {
            "description": "Dashboard summary",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "activeSites": { "type": "number" },
                    "activeCrawls": { "type": "number" },
                    "openIssues": { "type": "number" },
                    "complianceScore": { "type": "number" }
                  }
                }
              }
            }
          }
        }
      }
    },

    "/dashboard/trend": {
      "get": {
        "tags": ["Dashboard"],
        "summary": "Get accessibility score trend",
        "parameters": [
          {
            "name": "siteId",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Trend data",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "date": { "type": "string", "format": "date" },
                      "score": { "type": "number" }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },

    "/dashboard/issues-breakdown": {
      "get": {
        "tags": ["Dashboard"],
        "summary": "Get issues breakdown",
        "responses": {
          "200": {
            "description": "Issues grouped by severity",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "critical": { "type": "number" },
                    "serious": { "type": "number" },
                    "moderate": { "type": "number" },
                    "minor": { "type": "number" }
                  }
                }
              }
            }
          }
        }
      }
    },

    "/dashboard/latest-crawls": {
      "get": {
        "tags": ["Dashboard"],
        "summary": "Get latest crawl jobs",
        "responses": {
          "200": {
            "description": "Latest crawls list",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "type": "object"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/reports/site-summary": {
      "get": {
        "summary": "Get site accessibility summary",
        "parameters": [
          {
            "name": "siteId",
            "in": "query",
            "required": true,
            "schema": { "type": "string", "format": "uuid" }
          },
          {
            "name": "crawlJobId",
            "in": "query",
            "schema": { "type": "string", "format": "uuid" }
          },
          {
            "name": "startDate",
            "in": "query",
            "schema": { "type": "string", "format": "date" }
          },
          {
            "name": "endDate",
            "in": "query",
            "schema": { "type": "string", "format": "date" }
          }
        ],
        "responses": {
          "200": { "description": "Site summary returned" },
          "400": { "description": "Invalid request" }
        }
      }
    },

    "/reports/issues": {
      "get": {
        "summary": "Get severity breakdown of issues",
        "parameters": [
          {
            "name": "siteId",
            "in": "query",
            "required": true,
            "schema": { "type": "string", "format": "uuid" }
          },
          {
            "name": "crawlJobId",
            "in": "query",
            "schema": { "type": "string", "format": "uuid" }
          },
          {
            "name": "startDate",
            "in": "query",
            "schema": { "type": "string", "format": "date" }
          },
          {
            "name": "endDate",
            "in": "query",
            "schema": { "type": "string", "format": "date" }
          }
        ],
        "responses": {
          "200": { "description": "Severity breakdown returned" }
        }
      }
    },

    "/reports/top-pages": {
      "get": {
        "summary": "Get pages with most issues",
        "parameters": [
          {
            "name": "siteId",
            "in": "query",
            "required": true,
            "schema": { "type": "string", "format": "uuid" }
          },
          {
            "name": "crawlJobId",
            "in": "query",
            "schema": { "type": "string", "format": "uuid" }
          },
          {
            "name": "startDate",
            "in": "query",
            "schema": { "type": "string", "format": "date" }
          },
          {
            "name": "endDate",
            "in": "query",
            "schema": { "type": "string", "format": "date" }
          }
        ],
        "responses": {
          "200": { "description": "Top problem pages returned" }
        }
      }
    },

    "/reports/issues-table": {
      "get": {
        "summary": "Get paginated issues list",
        "parameters": [
          {
            "name": "siteId",
            "in": "query",
            "required": true,
            "schema": { "type": "string", "format": "uuid" }
          },
          {
            "name": "severity",
            "in": "query",
            "schema": {
              "type": "string",
              "enum": ["critical", "serious", "moderate", "minor"]
            }
          },
          {
            "name": "page",
            "in": "query",
            "schema": { "type": "integer", "default": 1 }
          },
          {
            "name": "limit",
            "in": "query",
            "schema": { "type": "integer", "default": 10 }
          },
          {
            "name": "crawlJobId",
            "in": "query",
            "schema": { "type": "string", "format": "uuid" }
          },
          {
            "name": "startDate",
            "in": "query",
            "schema": { "type": "string", "format": "date" }
          },
          {
            "name": "endDate",
            "in": "query",
            "schema": { "type": "string", "format": "date" }
          }
        ],
        "responses": {
          "200": { "description": "Issues table returned" }
        }
      }
    },

    "/reports/export": {
      "post": {
        "summary": "Generate accessibility report",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["siteId", "reportType"],
                "properties": {
                  "siteId": {
                    "type": "string",
                    "format": "uuid"
                  },
                  "crawlJobId": {
                    "type": "string",
                    "format": "uuid"
                  },
                  "reportType": {
                    "type": "string",
                    "enum": ["pdf"]
                  },
                  "filters": {
                    "type": "object",
                    "properties": {
                      "severity": {
                        "type": "string"
                      },
                      "startDate": {
                        "type": "string",
                        "format": "date"
                      },
                      "endDate": {
                        "type": "string",
                        "format": "date"
                      }
                    }
                  }
                }
              }
            }
          }
        },
        "responses": {
          "202": {
            "description": "Report generation started"
          },
          "400": {
            "description": "Invalid request"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "SignUpRequest": {
        "type": "object",
        "required": ["email", "password"],
        "properties": {
          "email": {
            "type": "string",
            "format": "email"
          },
          "password": {
            "type": "string",
            "minLength": 8
          }
        }
      },
      "SignInRequest": {
        "type": "object",
        "required": ["email", "password"],
        "properties": {
          "email": {
            "type": "string",
            "format": "email"
          },
          "password": {
            "type": "string"
          }
        }
      },
      "RefreshRequest": {
        "type": "object",
        "required": ["refreshToken"],
        "properties": {
          "refreshToken": {
            "type": "string"
          }
        }
      },
      "LogoutRequest": {
        "type": "object",
        "required": ["userId"],
        "properties": {
          "userId": {
            "type": "string"
          }
        }
      },
      "ForgotPasswordRequest": {
        "type": "object",
        "required": ["email"],
        "properties": {
          "email": {
            "type": "string"
          }
        }
      },
      "ResetPasswordRequest": {
        "type": "object",
        "required": ["email", "otp", "newPassword"],
        "properties": {
          "email": {
            "type": "string"
          },
          "otp": {
            "type": "string"
          },
          "newPassword": {
            "type": "string"
          }
        }
      }
    }
  }
}
